!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Scripts - raw extracted text and JSON (generated by extractPdf.mjs, not needed at runtime)
scripts/*.txt
scripts/*.json

# Vite temp files
*.timestamp-*.mjs

# Stray images (not part of the app)
*.jpeg
*.jpg
WhatsApp*

# Private notes (contains sensitive security analysis)
IMP NOTE.md

